<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="VaccineReport"
              pageWidth="842"
              pageHeight="595"
              orientation="Landscape"
              columnWidth="782"
              leftMargin="30"
              rightMargin="30"
              topMargin="20"
              bottomMargin="20">

    <!-- Fields -->
    <field name="id" class="java.lang.Long"/>
    <field name="vaccineName" class="java.lang.String"/>
    <field name="manufacturer" class="java.lang.String"/>
    <field name="expiryDate" class="java.util.Date"/>

    <!-- Title -->
    <title>
        <band height="55">

            <rectangle>
                <reportElement x="0" y="0" width="782" height="46"
                               backcolor="#1565C0" forecolor="#1565C0"/>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>

            <staticText>
                <reportElement x="0" y="4" width="782" height="38"
                               forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"
                             verticalAlignment="Middle">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[Vaccine Report]]></text>
            </staticText>

        </band>
    </title>

    <!-- Page Header -->
    <pageHeader>
        <band height="18">

            <staticText>
                <reportElement x="0" y="0" width="391" height="18"
                               forecolor="#666666"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <text><![CDATA[Vaccination Management System]]></text>
            </staticText>

            <textField pattern="dd-MM-yyyy HH:mm">
                <reportElement x="391" y="0" width="391" height="18"
                               forecolor="#666666"/>
                <textElement textAlignment="Right"
                             verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>

        </band>
    </pageHeader>

    <!-- Column Header -->
    <columnHeader>
        <band height="26">

            <rectangle>
                <reportElement x="0" y="0" width="782" height="26"
                               backcolor="#0D2137" forecolor="#0D2137"/>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>

            <staticText>
                <reportElement x="0" y="0" width="50" height="26"
                               forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"
                             verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[#]]></text>
            </staticText>

            <staticText>
                <reportElement x="50" y="0" width="80" height="26"
                               forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"
                             verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[ID]]></text>
            </staticText>

            <staticText>
                <reportElement x="130" y="0" width="280" height="26"
                               forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Vaccine Name]]></text>
            </staticText>

            <staticText>
                <reportElement x="410" y="0" width="220" height="26"
                               forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Manufacturer]]></text>
            </staticText>

            <staticText>
                <reportElement x="630" y="0" width="152" height="26"
                               forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"
                             verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Expiry Date]]></text>
            </staticText>

        </band>
    </columnHeader>

    <!-- Detail -->
    <detail>
        <band height="22">

            <!-- Alternate Row Color -->
            <rectangle>
                <reportElement x="0" y="0" width="782" height="22"
                               backcolor="#EEF2F7">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
                </reportElement>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>

            <textField>
                <reportElement x="0" y="0" width="50" height="22"
                               forecolor="#888888"/>
                <textElement textAlignment="Center"
                             verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{REPORT_COUNT}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="50" y="0" width="80" height="22"
                               forecolor="#888888"/>
                <textElement textAlignment="Center"
                             verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{id}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="130" y="0" width="280" height="22"/>
                <textElement verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{vaccineName}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="410" y="0" width="220" height="22"
                               forecolor="#1565C0"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{manufacturer}]]></textFieldExpression>
            </textField>

            <textField pattern="dd-MM-yyyy">
                <reportElement x="630" y="0" width="152" height="22"/>
                <textElement textAlignment="Center"
                             verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{expiryDate}]]></textFieldExpression>
            </textField>

        </band>
    </detail>

    <!-- Page Footer -->
    <pageFooter>
        <band height="20">

            <line>
                <reportElement x="0" y="0" width="782" height="1"
                               forecolor="#CCCCCC"/>
            </line>

            <staticText>
                <reportElement x="0" y="3" width="391" height="16"
                               forecolor="#888888"/>
                <textElement>
                    <font size="8"/>
                </textElement>
                <text><![CDATA[Vaccination Management System - Vaccine Report]]></text>
            </staticText>

            <textField>
                <reportElement x="391" y="3" width="391" height="16"
                               forecolor="#888888"/>
                <textElement textAlignment="Right">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>

        </band>
    </pageFooter>

    <!-- Summary -->
    <summary>
        <band height="30">

            <line>
                <reportElement x="0" y="4" width="782" height="1"
                               forecolor="#CCCCCC"/>
            </line>

            <textField>
                <reportElement x="0" y="10" width="400" height="18"
                               forecolor="#1565C0"/>
                <textElement>
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Total Vaccines : " + $V{REPORT_COUNT}]]></textFieldExpression>
            </textField>

        </band>
    </summary>

</jasperReport>