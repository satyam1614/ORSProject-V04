```xml
<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
	http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
	name="MobileListReport"
	pageWidth="842"
	pageHeight="595"
	orientation="Landscape"
	columnWidth="782"
	leftMargin="30"
	rightMargin="30"
	topMargin="20"
	bottomMargin="20">

	<!-- Fields -->
	<field name="id" class="java.lang.Long"/>
	<field name="code" class="java.lang.String"/>
	<field name="mobileNumber" class="java.lang.String"/>
	<field name="otp" class="java.lang.String"/>
	<field name="status" class="java.lang.String"/>

	<!-- Title -->
	<title>
		<band height="50">
			<staticText>
				<reportElement x="0" y="10" width="782" height="30"/>
				<textElement textAlignment="Center">
					<font size="18" isBold="true"/>
				</textElement>
				<text><![CDATA[Mobile List Report]]></text>
			</staticText>
		</band>
	</title>

	<!-- Column Header -->
	<columnHeader>
		<band height="25">

			<staticText>
				<reportElement x="0" y="0" width="50" height="25"/>
				<box>
					<pen lineWidth="1.0"/>
				</box>
				<textElement textAlignment="Center">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[ID]]></text>
			</staticText>

			<staticText>
				<reportElement x="50" y="0" width="150" height="25"/>
				<box>
					<pen lineWidth="1.0"/>
				</box>
				<textElement textAlignment="Center">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Code]]></text>
			</staticText>

			<staticText>
				<reportElement x="200" y="0" width="220" height="25"/>
				<box>
					<pen lineWidth="1.0"/>
				</box>
				<textElement textAlignment="Center">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Mobile Number]]></text>
			</staticText>

			<staticText>
				<reportElement x="420" y="0" width="150" height="25"/>
				<box>
					<pen lineWidth="1.0"/>
				</box>
				<textElement textAlignment="Center">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[OTP]]></text>
			</staticText>

			<staticText>
				<reportElement x="570" y="0" width="212" height="25"/>
				<box>
					<pen lineWidth="1.0"/>
				</box>
				<textElement textAlignment="Center">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Status]]></text>
			</staticText>

		</band>
	</columnHeader>

	<!-- Detail -->
	<detail>
		<band height="22">

			<textField>
				<reportElement x="0" y="0" width="50" height="22"/>
				<box>
					<pen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA[$F{id}]]></textFieldExpression>
			</textField>

			<textField>
				<reportElement x="50" y="0" width="150" height="22"/>
				<box>
					<pen lineWidth="0.5"/>
				</box>
				<textFieldExpression><![CDATA[$F{code}]]></textFieldExpression>
			</textField>

			<textField>
				<reportElement x="200" y="0" width="220" height="22"/>
				<box>
					<pen lineWidth="0.5"/>
				</box>
				<textFieldExpression><![CDATA[$F{mobileNumber}]]></textFieldExpression>
			</textField>

			<textField>
				<reportElement x="420" y="0" width="150" height="22"/>
				<box>
					<pen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA[$F{otp}]]></textFieldExpression>
			</textField>

			<textField>
				<reportElement x="570" y="0" width="212" height="22"/>
				<box>
					<pen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
			</textField>

		</band>
	</detail>

	<!-- Footer -->
	<pageFooter>
		<band height="20">
			<textField>
				<reportElement x="650" y="0" width="132" height="20"/>
				<textElement textAlignment="Right"/>
				<textFieldExpression><![CDATA["Page : " + $V{PAGE_NUMBER}]]></textFieldExpression>
			</textField>
		</band>
	</pageFooter>

	<!-- Summary -->
	<summary>
		<band height="25">
			<textField>
				<reportElement x="0" y="0" width="300" height="20"/>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["Total Records : " + $V{REPORT_COUNT}]]></textFieldExpression>
			</textField>
		</band>
	</summary>

</jasperReport>
```
